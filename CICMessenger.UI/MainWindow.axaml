<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CICMessenger.UI.Controls"
        x:Class="CICMessenger.UI.MainWindow"
        Icon="avares://CICMessenger/Assets/cic-logo.ico"
        Title="{Binding Title}"
        Width="1040" Height="650"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Menu Bar -->
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="versionButton" DockPanel.Dock="Right"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,2" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Click="VersionLabel_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock x:Name="versionLabel"
                               VerticalAlignment="Center"
                               FontSize="11" Opacity="0.7" />
                    <Border x:Name="updateBadge" IsVisible="False"
                            Background="#E8501E" CornerRadius="8"
                            Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="updateBadgeText" Foreground="White"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Button>
            <Menu>
                <MenuItem Header="{DynamicResource MainWindow_MainMenu_File}">
                    <MenuItem x:Name="mnuSignOut" Header="{DynamicResource MainWindow_MainMenu_SignOut}"
                              Click="SignOutMenu_Click" IsEnabled="{Binding IsLoggedIn}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource MainWindow_MainMenu_Close}" Click="CloseMenu_Click" />
                </MenuItem>
                <MenuItem Header="{DynamicResource MainWindow_MainMenu_Actions}">
                    <MenuItem Header="{DynamicResource MainWindow_SendBroadcastMessage}"
                              IsEnabled="{Binding IsLoggedIn}" Click="BroadcastMenu_Click" />
                </MenuItem>
                <MenuItem Header="{DynamicResource MainWindow_MainMenu_Tools}">
                    <MenuItem Header="{DynamicResource MainWindow_MainMenu_HistoryViewer}"
                              IsEnabled="{Binding IsLoggedIn}" Click="HistoryMenu_Click" />
                    <MenuItem Header="{DynamicResource MainWindow_MainMenu_LogViewer}" Click="LogViewerMenu_Click" />
                    <MenuItem Header="{DynamicResource MainWindow_MainMenu_Settings}" Click="SettingsMenu_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource MainWindow_MainMenu_CheckUpdate}" Click="UpdateMenu_Click" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Content Area: Sign-in, or the 3-column conversation layout -->
        <Panel>
            <controls:SignInControl x:Name="signInControl"
                                     IsVisible="{Binding !IsLoggedIn}" />

            <Grid IsVisible="{Binding IsLoggedIn}"
                  ColumnDefinitions="280,4,*,4,260">
                <controls:ContactListControl Grid.Column="0" x:Name="contactListControl" />

                <GridSplitter Grid.Column="1" Width="4"
                              Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <Panel Grid.Column="2">
                    <controls:ChatPaneControl x:Name="chatPane" IsVisible="False" />
                    <TextBlock x:Name="noConversationText"
                               Text="{DynamicResource SharedMedia_SelectConversation}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Panel>

                <GridSplitter Grid.Column="3" Width="4"
                              Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <controls:SharedMediaPanel Grid.Column="4" x:Name="sharedMediaPanel" />
            </Grid>
        </Panel>
    </DockPanel>
</Window>
