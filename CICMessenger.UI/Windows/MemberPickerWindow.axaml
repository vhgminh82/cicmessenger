<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CICMessenger.UI.Windows.MemberPickerWindow"
        Icon="avares://CICMessenger/Assets/cic-logo.ico"
        Title="{DynamicResource MemberPicker_Title}"
        Width="320" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <DockPanel Margin="12">
        <TextBlock x:Name="promptText" DockPanel.Dock="Top"
                   Text="{DynamicResource MemberPicker_SelectPrompt}"
                   Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="confirmButton" Content="{DynamicResource Global_OkButton}"
                    Click="Confirm_Click" Classes="accent" MinWidth="100" />
            <Button Content="{DynamicResource Global_CancelButton}"
                    Click="Cancel_Click" MinWidth="80" />
        </StackPanel>

        <ListBox x:Name="candidatesList" SelectionMode="Multiple,Toggle">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" Margin="4,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
