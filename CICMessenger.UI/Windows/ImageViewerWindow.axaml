<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CICMessenger.UI.Windows.ImageViewerWindow"
        Icon="avares://CICMessenger/Assets/cic-logo.ico"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid>
        <Image x:Name="fullImage"
               Stretch="Uniform"
               PointerPressed="Image_PointerPressed" />
        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="8" Padding="10,4"
                Click="Close_Click" />
    </Grid>
</Window>
