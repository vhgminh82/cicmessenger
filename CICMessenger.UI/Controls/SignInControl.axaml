<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CICMessenger.UI.Controls.SignInControl">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20">
        <StackPanel Spacing="12" MaxWidth="280" HorizontalAlignment="Center">
            <!-- App Icon/Title -->
            <TextBlock Text="CICMessenger"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#CC5500" />
            <TextBlock Text="Ứng dụng nhắn tin mạng nội bộ"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- Sign In Form -->
            <Border CornerRadius="8" Padding="16"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource MainWindow_SignIn_DisplayName}" />
                    <TextBox x:Name="txtDisplayName"
                             Watermark="{DynamicResource MainWindow_SignIn_Username}"
                             MaxLength="50" />

                    <Button x:Name="btnSignIn"
                            Content="{DynamicResource MainWindow_SignIn_SignInButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="SignIn_Click"
                            Background="#1B5E20"
                            Foreground="White"
                            Height="36" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
