<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CICMessenger.UI.Controls"
             x:Class="CICMessenger.UI.Controls.ChatPaneControl">
    <DockPanel>
        <!-- Conversation header -->
        <Border DockPanel.Dock="Top" Padding="12,10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="headerName" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="headerSubtitle" FontSize="11" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button ToolTip.Tip="Lưu cuộc trò chuyện" Click="Save_Click"
                            Padding="6,2" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="💾" FontSize="15" />
                    </Button>
                    <Button ToolTip.Tip="Sao chép" Click="Copy_Click"
                            Padding="6,2" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="📋" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" />
            </Grid.RowDefinitions>

            <!-- Conversation Display -->
            <Border Grid.Row="0" CornerRadius="4"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <ScrollViewer x:Name="messageScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="messagesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,2"
                                        Padding="8,4"
                                        CornerRadius="8"
                                        MaxWidth="360"
                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                        Background="{Binding Background}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Text="{Binding SenderName}"
                                                       DockPanel.Dock="Left" />
                                            <TextBlock FontSize="10"
                                                       Opacity="0.6"
                                                       Text="{Binding Timestamp}"
                                                       DockPanel.Dock="Right"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <controls:MarkdownTextBlock TextWrapping="Wrap"
                                                                       Margin="0,2,0,0"
                                                                       IsVisible="{Binding IsText}"
                                                                       Markdown="{Binding Text}" />
                                        <StackPanel IsVisible="{Binding IsImage}" Margin="0,2,0,0" Spacing="2">
                                            <Image Source="{Binding ImageSource}"
                                                   MaxWidth="280" MaxHeight="280"
                                                   HorizontalAlignment="Left"
                                                   Stretch="Uniform"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Tapped="Image_Tapped">
                                                <Image.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Mở trong Explorer" Tag="{Binding FilePath}" Click="OpenInExplorer_Click" />
                                                    </ContextMenu>
                                                </Image.ContextMenu>
                                            </Image>
                                            <TextBlock Text="{Binding Text}" FontSize="10" Opacity="0.7" />
                                        </StackPanel>
                                        <Button IsVisible="{Binding IsVideo}" Margin="0,2,0,0"
                                                Tag="{Binding FilePath}" Click="OpenFile_Click"
                                                HorizontalAlignment="Left">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Mở trong Explorer" Tag="{Binding FilePath}" Click="OpenInExplorer_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="▶" FontSize="16" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button IsVisible="{Binding IsFile}" Margin="0,2,0,0"
                                                Tag="{Binding FilePath}" Click="OpenFile_Click"
                                                HorizontalAlignment="Left">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Mở trong Explorer" Tag="{Binding FilePath}" Click="OpenInExplorer_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="📄" FontSize="16" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Typing indicator -->
            <TextBlock Grid.Row="1" x:Name="typingIndicator"
                       FontSize="11" Margin="4,2"
                       Foreground="Gray"
                       IsVisible="False" />

            <!-- Toolbar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                <Button ToolTip.Tip="{DynamicResource Buddy_SendFile}" Click="SendFile_Click"
                        Padding="6,2" Margin="0,0,4,0">
                    <TextBlock Text="📎" FontSize="16" />
                </Button>
                <Button ToolTip.Tip="{DynamicResource Emoticon_Smile}" Click="Emoticon_Click"
                        Padding="6,2" Margin="0,0,4,0">
                    <TextBlock Text="😊" FontSize="16" />
                </Button>
                <Button ToolTip.Tip="{DynamicResource ChatWindow_SendScreenshot}" Click="Screenshot_Click"
                        Padding="6,2">
                    <TextBlock Text="🖼" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Message Input -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBox x:Name="txtMessage"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Watermark="{DynamicResource ChatWindow_TypeMessageHere}" />
                <Button Grid.Column="1"
                        Content="{DynamicResource ChatWindow_SendButton}"
                        Click="SendButton_Click"
                        Margin="4,0,0,0"
                        VerticalAlignment="Stretch"
                        Width="70"
                        Classes="accent" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
