<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CICMessenger.UI.Controls.SharedMediaPanel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{DynamicResource SharedMedia_Header}" FontWeight="SemiBold" FontSize="13" />
        </Border>

        <TextBlock x:Name="emptyText" DockPanel.Dock="Top"
                   Text="{DynamicResource SharedMedia_SelectConversation}"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   TextWrapping="Wrap" Margin="12" FontSize="12" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="groupsControl" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" FontSize="12"
                                       Margin="4,4,4,4"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2" Padding="6" CornerRadius="4"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Tapped="Item_Tapped">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Mở trong Explorer" Tag="{Binding FilePath}" Click="OpenInExplorer_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Panel Width="36" Height="36">
                                                    <Image Source="{Binding Thumbnail}" IsVisible="{Binding IsImage}"
                                                           Stretch="UniformToFill" Width="36" Height="36" />
                                                    <TextBlock Text="📄" FontSize="20" IsVisible="{Binding !IsImage}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Panel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                    <TextBlock Text="{Binding TimestampText}" FontSize="9" Opacity="0.6" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
