<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <!-- Shown as V{Major}.{Minor}. Each release bumps Minor by one, i.e. +0.01 on the
         displayed number: 0.11 -> 0.12 -> 0.13. Tag releases to match, e.g. v0.12.0. -->
    <Version>0.15.0</Version>
    <AssemblyVersion>0.15.0.0</AssemblyVersion>
    <Company>CIC</Company>
    <Product>CICMessenger</Product>
    <Copyright>Copyright © 2026 CIC</Copyright>

    <!-- Trimming: enable trim analyzers globally to surface warnings,
         but only enable PublishTrimmed in non-WPF projects (WPF blocks trimming).
         Library projects opt in with IsTrimmable in their csproj. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
</Project>
