<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Company>CIC</Company>
    <Product>CICMessenger</Product>
    <Copyright>Copyright © 2026 CIC</Copyright>

    <!-- Trimming: enable trim analyzers globally to surface warnings,
         but only enable PublishTrimmed in non-WPF projects (WPF blocks trimming).
         Library projects opt in with IsTrimmable in their csproj. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
</Project>
