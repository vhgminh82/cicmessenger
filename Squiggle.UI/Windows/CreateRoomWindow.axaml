<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Squiggle.UI.Windows.CreateRoomWindow"
        Icon="avares://CICMessenger/Assets/cic-logo.ico"
        Title="{DynamicResource CreateRoom_Title}"
        Width="360" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{DynamicResource CreateRoom_SelectContacts}"
                   Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{DynamicResource CreateRoom_CreateButton}"
                    Click="Create_Click" Classes="accent" MinWidth="100" />
            <Button Content="{DynamicResource Global_CancelButton}"
                    Click="Cancel_Click" MinWidth="80" />
        </StackPanel>

        <ListBox x:Name="contactsList" SelectionMode="Multiple,Toggle">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" Margin="4,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
