<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Squiggle.UI</RootNamespace>
    <AssemblyName>CICMessenger</AssemblyName>
    <ApplicationIcon>Assets\cic-logo.ico</ApplicationIcon>
    <!-- Needed for the pointer-based pixel copy in ScreenCapture -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The repo disables generated assembly info and relies on Shared/AssemblyInfo*.cs,
         which this project does not include — leaving the version at 0.0.0.0 and showing
         "V0.0" in the UI. Generate it here so <Version> actually reaches the assembly. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Desktop chat app: favour a small memory footprint over throughput.
         Referencing Microsoft.AspNetCore.App (for the gRPC chat host) otherwise
         pulls in server-oriented GC defaults. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0-9; higher trades a little CPU for a smaller managed heap -->
    <RuntimeHostConfigurationOption Include="System.GC.Conserve" Value="5" Trim="true" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\cic-logo.ico" />
    <AvaloniaResource Include="Assets\cic-logo-256.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.*" />
    <PackageReference Include="Serilog" Version="4.2.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Squiggle.Client\Squiggle.Client.csproj" />
    <ProjectReference Include="..\Squiggle.FileTransfer\Squiggle.FileTransfer.csproj" />
    <ProjectReference Include="..\Squiggle.Core\Squiggle.Core.csproj" />
    <ProjectReference Include="..\Squiggle.History\Squiggle.History.csproj" />
    <ProjectReference Include="..\Squiggle.Infrastructure\Squiggle.Infrastructure.csproj" />
    <ProjectReference Include="..\Squiggle.Utilities\Squiggle.Utilities.csproj" />
  </ItemGroup>
</Project>
